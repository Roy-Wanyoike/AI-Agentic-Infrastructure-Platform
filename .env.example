APP_ENV=development
API_PORT=8080
WORKER_PORT=8081
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos
REDIS_HOST=localhost
REDIS_PORT=6379
NATS_URL=nats://localhost:4222

# Task queue backend: memory (default, zero infra) | redis (shared across processes)
AGENTOS_QUEUE=memory
# REDIS_QUEUE_KEY=agentos:queue

# Model provider (worker run execution AND API evaluation runner): any
# OpenAI-compatible /chat/completions endpoint. With OPENAI_API_KEY unset both
# processes run the deterministic offline mode (zero infrastructure, no keys).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENTOS_WORKER_MODEL=gpt-4o-mini
# Failover (optional): the fallback endpoint is tried after transient primary
# failures (429/5xx/network); only read when AGENTOS_FALLBACK_API_KEY is set.
# AGENTOS_FALLBACK_API_KEY=
# AGENTOS_FALLBACK_BASE_URL=https://api.openai.com/v1

# Model pricing override (USD per 1M tokens): JSON array of
# {"model":"gpt-4o","input_per_m_tokens":2.5,"output_per_m_tokens":10}
# AGENTOS_PRICING_JSON=

# Durable workflow recovery: staleness threshold for orphaned workflow runs
# AGENTOS_WORKFLOW_STALE_AFTER=5m

# Knowledge/RAG embeddings (OpenAI-compatible /embeddings; unset = offline mode)
# AGENTOS_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AGENTOS_EMBEDDING_MODEL=text-embedding-3-small
# AGENTOS_EMBEDDING_API_KEY=

# Secrets management (issue #25): master key for AES-256-GCM encryption at rest.
# REQUIRED when the API runs in Postgres mode — the secrets service fails fast
# at startup without a valid key (plaintext persistence is refused). Generate
# with `openssl rand -base64 32` (must decode to exactly 32 bytes). In-memory
# mode needs no key. Keep this OUT of version control in real deployments;
# rotating: register the next key version, then re-seal (v1 envelope keeps old
# rows readable during rotation).
# AGENTOS_SECRETS_MASTER_KEY=
