# Base URL of the AgentOS Go API (no trailing slash)
VITE_API_URL=http://localhost:8080

# Path prefix the API is served under.
# Canonical: api/v1 — the backend serves the same routes under /v1 as well.
VITE_API_PREFIX=api/v1

# Display name used in the UI chrome
VITE_APP_NAME=AgentOS

VITE_ENV=development
