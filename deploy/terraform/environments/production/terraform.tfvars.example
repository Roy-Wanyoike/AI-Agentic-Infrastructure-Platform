# Example tfvars for the production environment.
# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)
# Sensitive values: pass via TF_VAR_cluster_token / TF_VAR_cluster_ca_cert in CI.
aws_region     = "us-east-1"
cluster_endpoint = "https://EXAMPLE.gr7.us-east-1.eks.amazonaws.com"
cluster_oidc_issuer = "https://oidc.eks.us-east-1.amazonaws.com/id/EXAMPLEDOCS"
vpc_id              = "vpc-0123456789abcdef0"
private_subnet_ids  = ["subnet-0a1b2c3d4e5f60001", "subnet-0a1b2c3d4e5f60002", "subnet-0a1b2c3d4e5f60003"]
cluster_node_security_group_id = "sg-0123456789abcdef0"
image_tag           = "0.1.0" # pin the exact released tag (IMMUTABLE ECR)
