# syntax=docker/dockerfile:1
# AgentOS dashboard image (React 19 + Vite, served by nginx).
#
# Stage 1 builds the SPA with node:22-alpine (`npm ci` + `npm run build`).
# Stage 2 serves web/dist from nginx:alpine with the SPA fallback and API
# reverse proxy defined in deploy/nginx.conf:
#   - /            -> SPA shell (try_files ... /index.html)
#   - /api/v1/...  -> proxy_pass http://api:8080 (canonical API prefix)
#   - /v1/...      -> proxy_pass http://api:8080 (legacy prefix)
#   - /healthz, /readyz -> proxied for external probes
#
# Same-origin API by default: the build bakes VITE_API_URL=/api and
# VITE_API_PREFIX=v1 (web/src/lib/api/client.ts), so the browser calls its own
# origin and nginx forwards to the api service. For a split-domain deployment
# override the build args, e.g.
#   docker build -f Dockerfile.web \
#     --build-arg VITE_API_URL=https://api.example.com \
#     --build-arg VITE_API_PREFIX=v1 -t agentos/web:latest .
#
# Build: docker build -f Dockerfile.web -t agentos/web:latest .

FROM node:22-alpine AS build
WORKDIR /src
# Cache deps first: lockfile changes are rarer than source changes.
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ARG VITE_API_URL=/api
ARG VITE_API_PREFIX=v1
ARG VITE_APP_NAME=AgentOS
ARG VITE_ENV=production
ENV VITE_API_URL=$VITE_API_URL \
    VITE_API_PREFIX=$VITE_API_PREFIX \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_ENV=$VITE_ENV
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
# nginx:alpine ships busybox wget, so an image-level HEALTHCHECK is possible
# here (unlike the distroless Go images). docker-compose.prod.yml also probes
# at compose level; keeping both is harmless.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
